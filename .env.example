# ── LLM & AI Provider API Keys ───────────────────────────────────────────────
# Mistral API Key (Required for Summarization, Extraction, and RAG Chat)
# Get your free/paid key from https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI Key (Optional: Required only if choosing Hinglish language)
# Get key from https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5

# ── Speech to Text (Whisper) ──────────────────────────────────────────────────
# Options: tiny, base, small, medium, large (default: small)
WHISPER_MODEL=small

# ── FastAPI Configuration (Optional) ──────────────────────────────────────────
# Secret key for API authentication (leave blank if not using service key)
SERVICE_API_KEY=
SESSION_TTL_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:3000
PORT=8000
